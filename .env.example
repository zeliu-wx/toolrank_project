# Official DeepSeek chat defaults used by LAKES.
LAKES_OPENAI_BASE_URL=https://api.deepseek.com
LAKES_OPENAI_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=your-deepseek-api-key

# For another OpenAI-compatible chat provider, override the URL/model above
# and supply its credential through OPENAI_API_KEY. On official DeepSeek hosts,
# DEEPSEEK_API_KEY takes precedence over this generic fallback.
# OPENAI_API_KEY=your-api-key

# Optional: external analyzer locations used by --execute.
LAKES_SMARTBUGS_DIR=
LAKES_SECURIFY2_RUNNER=
LAKES_GPTSCAN_ROOT=
LAKES_SAILFISH_RUNNER=
LAKES_SMARTIAN_RUNNER=
